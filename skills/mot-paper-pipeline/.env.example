GITHUB_TOKEN=
LLM_API_KEY=

# Required repository target: replace with your fork/repository.
MOT_GITHUB_REPO=mgou068-eng/MOT-PaperClaw

# Optional runtime settings
GITHUB_TIMEOUT=15
GITHUB_RETRY=2
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=https://api.deepseek.com/chat/completions
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=MOT-PaperClaw/1.0 (+https://github.com/mgou068-eng/MOT-PaperClaw)
MOT_TEMP_DIR=/tmp
MOT_FILTER_KEYWORDS_FILE=scripts/config/filter_keywords.json
MOT_FILTER_PROMPT_FILE=scripts/prompts/filter_cross_prompt.md

# Optional network / integration settings
MOT_PROXY_URL=
FEISHU_TARGET=
DINGTALK_WEBHOOK=

# Keep these empty unless intentionally running inside an OpenClaw workspace.
MOT_WORKSPACE=
OPENCLAW_BIN=

# Legacy RS_* names remain readable for existing deployments.
